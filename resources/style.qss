/* A1-esque theme: card-style tiles, green accent, color-coded status.
   Colors below are placeholders substituted by ui/theme.py for the active
   light/dark mode (string.Template, not str.format -- QSS's own `{ }` block
   syntax would collide with format-string braces). */

QWidget#mainWindow, QWidget {
    background-color: $bg;
    color: $fg;
    font-size: 20px;
}

QWidget#statusBar {
    background-color: $bg_deep;
    border-bottom: 1px solid $border;
}
QLabel#statusNozzle, QLabel#statusBed {
    color: $muted;
    padding-right: 12px;
}
QLabel#statusConnection, QLabel#statusCamera {
    font-size: 22px;
}
QPushButton#statusQuit {
    background-color: transparent;
    border: 1px solid $danger_border;
    border-radius: 18px;
    min-height: 0px;
    padding: 0px;
    margin-left: 8px;
    color: $danger_text;
    font-weight: bold;
}
QPushButton#statusQuit:pressed {
    background-color: $danger_solid;
    color: white;
}

QPushButton {
    background-color: $button_bg;
    color: $fg;
    border: 1px solid $button_border;
    border-radius: 8px;
    padding: 10px 14px;
    min-height: 40px;
}
QPushButton:pressed {
    background-color: $accent;
    color: $accent_contrast;
}
QPushButton#dangerButton {
    border-color: $danger_border;
}
QPushButton#dangerButton:pressed {
    background-color: $danger_solid;
    color: white;
}

QWidget#navTile QPushButton#navTileButton {
    background-color: $card_bg;
    border: 1px solid $card_border;
    border-radius: 16px;
}
QWidget#navTile QPushButton#navTileButton:pressed {
    background-color: $accent;
}
QLabel#navTileIcon {
    font-size: 96px;
}
QLabel#navTileLabel {
    font-size: 30px;
    color: $muted;
}

QPushButton#printBanner {
    background-color: $banner_bg;
    border: 1px solid $accent;
    border-radius: 12px;
    text-align: left;
    padding: 16px;
    font-size: 22px;
}

QFrame#amsSlot {
    background-color: $card_bg;
    border: 1px solid $card_border;
    border-radius: 10px;
    padding: 8px;
}
QFrame#amsSlot[active="true"] {
    border: 2px solid $accent;
}
QLabel#amsSwatch {
    border: 1px solid $swatch_border;
}

QWidget#hmsBanner {
    background-color: $hms_bg;
    border-bottom: 1px solid $hms_border;
}
QLabel#hmsBannerLabel {
    color: $hms_text;
    font-size: 19px;
}
QPushButton#hmsBannerDismiss {
    background-color: transparent;
    border: 1px solid $hms_border;
    min-height: 0px;
    padding: 4px 10px;
}

QLabel#toast {
    background-color: $button_bg;
    color: $fg;
    border-bottom: 1px solid $button_border;
    padding: 8px 16px;
    font-size: 19px;
}

QWidget#connectionOverlay {
    background-color: rgba(10, 12, 14, 200);
}
QLabel#connectionOverlayLabel {
    color: #ffffff;
    font-size: 27px;
}

QWidget#loadingOverlay {
    background-color: rgba(10, 12, 14, 160);
}

QLabel#cameraFeed {
    background-color: #000000;
    border: 1px solid $border;
    border-radius: 8px;
}

QProgressBar {
    border: 1px solid $card_border;
    border-radius: 6px;
    text-align: center;
    background-color: $card_bg;
}
QProgressBar::chunk {
    background-color: $accent;
    border-radius: 6px;
}

QDialog#keypadDialog {
    background-color: $bg;
}
QLabel#keypadDisplay {
    background-color: $bg_deep;
    border: 1px solid $card_border;
    border-radius: 8px;
    font-size: 34px;
}
QPushButton#keypadDigit {
    font-size: 24px;
}
QPushButton#keypadConfirm {
    background-color: $accent;
    color: $accent_contrast;
    font-weight: bold;
}
